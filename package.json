{
  "name": "vibe-coding-then-what",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "npm run codegen && NEXT_TELEMETRY_DISABLED=1 next dev site",
    "build": "npm run codegen && NEXT_TELEMETRY_DISABLED=1 next build site",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/vibe-coding-then-what npm run build",
    "lint": "eslint site scripts tests eslint.config.mjs playwright.config.mjs panda.config.ts panda --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:install": "playwright install chromium",
    "check": "npm run lint && npm run typecheck && npm test",
    "verify:export": "node scripts/verify-export.mjs",
    "release:metadata": "node scripts/release-metadata.mjs",
    "release:smoke": "node scripts/public-smoke.mjs",
    "typecheck": "npm run codegen && NEXT_TELEMETRY_DISABLED=1 next typegen site && tsc --project site/tsconfig.json --noEmit && tsc --project tsconfig.panda.json --noEmit",
    "codegen": "panda codegen",
    "prepare": "npm run codegen"
  },
  "dependencies": {
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm-table": "2.0.1",
    "micromark-extension-gfm-table": "2.1.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@pandacss/dev": "2.5.0",
    "@playwright/test": "1.65.1",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "pkg-types": "2.3.0",
    "postcss": "8.5.33",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
